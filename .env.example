# ==============================================================================
# Max Agent Daemon - Environment Configuration Example
# ==============================================================================

MAX_HOST=127.0.0.1
MAX_PORT=4848
MAX_DEBUG=true

# OpenAI-Compatible Provider Configuration
OPENAI_BASE_URL=http://localhost:1234/v1
OPENAI_API_KEY=sk-local-no-key-required

# Active Model Selection
OPENAI_MODEL=gemma-4-31b

# Alternative Model Examples:
# OPENAI_MODEL=claude-1
# OPENAI_MODEL=claude-3-5-sonnet
# OPENAI_MODEL=qwen2.5-32b-instruct
# OPENAI_MODEL=gpt-4o-mini
