# ==============================================================================
# Maxi Agent Daemon - Environment Configuration Example
# ==============================================================================

MAX_HOST=127.0.0.1
MAX_PORT=4848
MAX_DEBUG=true

# Main Agent: OpenAI-Compatible Provider Configuration (Ollama, LM Studio, etc.)
OPENAI_BASE_URL=http://localhost:11434/v1
OPENAI_API_KEY=sk-local-no-key-required
OPENAI_MODEL=gemma4:31b-cloud

# ------------------------------------------------------------------------------
# Voice Service Configuration (Groq Whisper / OpenAI-compatible STT)
# ------------------------------------------------------------------------------
VOICE_BASE_URL=https://api.groq.com/openai/v1
VOICE_API_KEY=gsk_your_groq_or_grok_key_here
VOICE_MODEL=whisper-large-v3-turbo
ENABLE_VOICE_HOTKEY=true
VOICE_SYSTEM_PROMPT="You are Maxi Voice. Provide direct, single-sentence spoken answers without markdown, bullets, asterisks, or bold text."
